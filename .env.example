APP_NAME=AgroVida
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8081
NGROK_AUTHTOKEN=

TRANSPORTE_CODIGO_DIAS=7
TRANSPORTE_GPS_INTERVALO=10

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=mercado_agricola
