        $totalParaConv    = $pedidosTotales->count();
        $pedidosEntregados = $pedidosTotales->where('estado', 'entregado')->count();
        $tasaConversion   = $totalParaConv > 0 ? round(($pedidosEntregados / $totalParaConv) * 100, 2) : 0;

