            'ticketPromedio'     => $ticketPromedio,
            'tasaConversion'     => $tasaConversion,
        ]);

        $fechaArchivo = Carbon::now()->format('Y-m-d_His');

        return $pdf->download('reporte_ventas_' . $fechaArchivo . '.pdf');
